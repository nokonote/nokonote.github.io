---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<h1>旅ブログ</h1>
		<p>国内旅行のモデルコースやグルメ、費用シミュレーションなどを綴っています。</p>
		<a class="cta" href="/blog/">記事一覧を見る →</a>
	</main>
</Layout>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 4rem 1rem;
		font-family: system-ui, sans-serif;
		text-align: center;
	}

	.cta {
		display: inline-block;
		margin-top: 1.5rem;
		color: #0057b8;
		text-decoration: none;
		font-weight: 600;
	}

	.cta:hover {
		text-decoration: underline;
	}
</style>
