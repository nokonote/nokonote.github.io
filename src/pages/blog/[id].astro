---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { categoryLabels, tripStyleLabels, formatDate } from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | 旅ブログ`} description={post.data.description}>
	<main>
		<p class="back"><a href="/blog/">← 記事一覧に戻る</a></p>
		<article>
			<header>
				<h1>{post.data.title}</h1>
				<p class="meta">
					<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
					<span class="badge">{categoryLabels[post.data.category]}</span>
					<span class="badge">{tripStyleLabels[post.data.tripStyle]}</span>
				</p>
				{post.data.tags.length > 0 && (
					<p class="tags">
						{post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
					</p>
				)}
			</header>
			<div class="content">
				<Content />
			</div>
		</article>
	</main>
</Layout>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1rem;
		font-family: system-ui, sans-serif;
	}

	.back a {
		color: #666;
		text-decoration: none;
		font-size: 0.9rem;
	}

	.back a:hover {
		text-decoration: underline;
	}

	header {
		margin-bottom: 2rem;
	}

	h1 {
		margin: 0.5rem 0;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: #666;
		font-size: 0.875rem;
		margin: 0 0 0.5rem;
	}

	.badge {
		background: #f0f0f0;
		border-radius: 999px;
		padding: 0.15rem 0.6rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.8rem;
		color: #888;
	}

	.content {
		line-height: 1.8;
	}

	.content :global(h2) {
		margin-top: 2rem;
	}

	.content :global(h3) {
		margin-top: 1.5rem;
	}
</style>
