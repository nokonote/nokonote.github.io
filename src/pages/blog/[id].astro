---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { categoryLabels, categoryIcons, categoryColors, tripStyleLabels, tripStyleIcons, formatDate } from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
	.filter((other) => other.id !== post.id)
	.map((other) => {
		const sameCategory = other.data.category === post.data.category ? 2 : 0;
		const sharedTags = other.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
		return { post: other, score: sameCategory + sharedTags };
	})
	.filter((entry) => entry.score > 0)
	.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
	.slice(0, 3)
	.map((entry) => entry.post);
const colors = categoryColors[post.data.category];
const hero = post.data.heroImage;
const heroStyle = hero
	? `--from:${colors.from}; --to:${colors.to}; background-image: linear-gradient(180deg, rgba(30,20,10,0.15), rgba(30,20,10,0.65)), url(${hero.src});`
	: `--from:${colors.from}; --to:${colors.to};`;
---

<Layout title={`${post.data.title} | 旅ブログ`} description={post.data.description}>
	<main id="main" data-pagefind-body>
		<article>
			<header class:list={['hero', { 'has-photo': hero }]} style={heroStyle}>
				<div class="hero-inner">
					<a class="back" href="/blog/">← 記事一覧に戻る</a>
					<p class="category">{categoryIcons[post.data.category]} {categoryLabels[post.data.category]}</p>
					<h1>{post.data.title}</h1>
					<p class="meta">
						<time datetime={post.data.pubDate.toISOString()}>📅 {formatDate(post.data.pubDate)}</time>
						<span class="badge">{tripStyleIcons[post.data.tripStyle]} {tripStyleLabels[post.data.tripStyle]}</span>
					</p>
				</div>
				{hero && (
					<p class="hero-credit">
						📷 Photo by <a href={hero.credit.url}>{hero.credit.name}</a> on {hero.credit.source}
					</p>
				)}
			</header>

			<div class="content-wrap">
				{post.data.tags.length > 0 && (
					<p class="tags">
						{post.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>🏷️ {tag}</a>)}
					</p>
				)}
				<div class="content">
					<Content />
				</div>

				{relatedPosts.length > 0 && (
					<section class="related">
						<h2>🧭 関連記事</h2>
						<ul class="related-grid">
							{relatedPosts.map((relatedPost) => <PostCard post={relatedPost} />)}
						</ul>
					</section>
				)}

				<p class="back back-bottom"><a href="/blog/">🗺️ 記事一覧に戻る</a></p>
			</div>
		</article>
	</main>
</Layout>

<style>
	.hero {
		background: linear-gradient(135deg, var(--from), var(--to));
		background-size: cover;
		background-position: center;
		color: #fff;
		padding: 3rem 1.25rem 3.5rem;
		position: relative;
	}

	.hero.has-photo {
		padding-bottom: 4.25rem;
	}

	.hero-inner {
		max-width: 720px;
		margin: 0 auto;
	}

	.hero .back {
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		font-size: 0.875rem;
	}

	.hero .back:hover {
		text-decoration: underline;
	}

	.hero .category {
		margin: 1.25rem 0 0.5rem;
		font-weight: 500;
		font-size: 0.9rem;
		opacity: 0.95;
	}

	.hero h1 {
		margin: 0 0 0.75rem;
		font-size: 2rem;
		line-height: 1.5;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
	}

	.hero .meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: 0.9rem;
	}

	.hero .badge {
		background: rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		padding: 0.15rem 0.7rem;
	}

	.hero-credit {
		position: absolute;
		right: 1.25rem;
		bottom: 0.75rem;
		margin: 0;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.8);
	}

	.hero-credit a {
		color: #fff;
		text-decoration: underline;
	}

	.content-wrap {
		max-width: 720px;
		margin: -1.75rem auto 0;
		background: var(--color-surface);
		border-radius: var(--radius-lg) var(--radius-lg) 0 0;
		padding: 2.5rem 1.75rem 3.5rem;
		box-shadow: var(--shadow-lg);
		position: relative;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.75rem;
	}

	.tag {
		font-size: 0.8rem;
		color: var(--color-sky);
		background: var(--color-bg-alt);
		border-radius: 999px;
		padding: 0.15rem 0.7rem;
		text-decoration: none;
		transition: background 0.15s ease;
	}

	.tag:hover {
		background: var(--color-border);
	}

	.related {
		margin-top: 3.5rem;
	}

	.related h2 {
		margin: 0 0 1.25rem;
		padding-left: 0.85rem;
		border-left: 6px solid var(--color-accent);
		font-size: 1.4rem;
	}

	.related-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.25rem;
	}

	.content {
		font-size: 1.05rem;
		line-height: 1.9;
		color: var(--color-text);
	}

	.content :global(h2) {
		margin: 2.5rem 0 1rem;
		padding-left: 0.85rem;
		border-left: 6px solid var(--color-accent);
		font-size: 1.4rem;
	}

	.content :global(h3) {
		margin: 1.75rem 0 0.75rem;
		font-size: 1.15rem;
		color: var(--color-accent-dark);
	}

	.content :global(p) {
		margin: 0 0 1.25rem;
	}

	.content :global(ul),
	.content :global(ol) {
		margin: 0 0 1.25rem;
		padding-left: 1.5rem;
	}

	.content :global(li) {
		margin-bottom: 0.4rem;
	}

	.content :global(li)::marker {
		color: var(--color-accent);
	}

	.content :global(strong) {
		color: var(--color-accent-dark);
	}

	.content :global(a) {
		color: var(--color-sky);
	}

	.content :global(blockquote) {
		margin: 0 0 1.25rem;
		padding: 0.75rem 1.25rem;
		background: var(--color-bg-alt);
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
	}

	.content :global(figure.post-image) {
		margin: 2rem 0;
	}

	.content :global(figure.post-image img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
		display: block;
	}

	.content :global(figure.post-image figcaption) {
		margin-top: 0.5rem;
		font-size: 0.75rem;
		color: var(--color-text-muted);
		text-align: center;
	}

	.content :global(figure.post-image figcaption a) {
		color: var(--color-text-muted);
		text-decoration: underline;
	}

	.back-bottom {
		margin-top: 3rem;
		text-align: center;
	}

	.back-bottom a {
		display: inline-block;
		text-decoration: none;
		color: var(--color-accent-dark);
		font-weight: 500;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.6rem 1.5rem;
		transition: background 0.15s ease;
	}

	.back-bottom a:hover {
		background: var(--color-bg-alt);
	}
</style>
