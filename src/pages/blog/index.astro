---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { categoryLabels, tripStyleLabels, formatDate } from '../../utils/blog';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="記事一覧 | 旅ブログ" description="国内旅行のモデルコースやグルメ、費用シミュレーションなどをまとめた記事一覧です。">
	<main>
		<h1>記事一覧</h1>
		{posts.length === 0 && <p>まだ記事がありません。</p>}
		<ul class="post-list">
			{posts.map((post) => (
				<li class="post-card">
					<a href={`/blog/${post.id}/`}>
						<h2>{post.data.title}</h2>
						<p class="meta">
							<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							<span class="badge">{categoryLabels[post.data.category]}</span>
							<span class="badge">{tripStyleLabels[post.data.tripStyle]}</span>
						</p>
						<p class="description">{post.data.description}</p>
						{post.data.tags.length > 0 && (
							<p class="tags">
								{post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
							</p>
						)}
					</a>
				</li>
			))}
		</ul>
	</main>
</Layout>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1rem;
		font-family: system-ui, sans-serif;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.post-card a {
		display: block;
		text-decoration: none;
		color: inherit;
		border: 1px solid #e2e2e2;
		border-radius: 0.75rem;
		padding: 1.25rem 1.5rem;
		transition: border-color 0.2s ease;
	}

	.post-card a:hover {
		border-color: #888;
	}

	.post-card h2 {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		color: #666;
		font-size: 0.875rem;
		margin: 0 0 0.5rem;
	}

	.badge {
		background: #f0f0f0;
		border-radius: 999px;
		padding: 0.15rem 0.6rem;
	}

	.description {
		margin: 0 0 0.5rem;
		color: #333;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.8rem;
		color: #888;
	}
</style>
