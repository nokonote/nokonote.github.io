---
import Layout from '../layouts/Layout.astro';
---

<Layout title="記事を検索 | 旅ブログ" description="旅ブログの記事をキーワードで検索できます。">
	<main id="main">
		<div class="page-header">
			<h1>🔍 記事を検索</h1>
			<p>キーワードを入力して、旅ブログの記事を探せます。</p>
		</div>
		<div id="search">
			<p class="search-fallback">検索を読み込み中です…</p>
		</div>
	</main>
</Layout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline>
	(function () {
		var script = document.createElement('script');
		script.src = '/pagefind/pagefind-ui.js';
		script.onload = function () {
			// eslint-disable-next-line no-undef
			new PagefindUI({ element: '#search', showSubResults: true, resetStyles: false });
		};
		script.onerror = function () {
			var el = document.getElementById('search');
			if (el) {
				el.innerHTML =
					'<p class="search-fallback">検索機能は本番ビルド（<code>npm run build</code>）後に利用できます。<code>astro dev</code> での開発中は動作しません。</p>';
			}
		};
		document.head.appendChild(script);
	})();
</script>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
	}

	.page-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.page-header h1 {
		margin: 0 0 0.5rem;
		font-size: 2rem;
		color: var(--color-accent-dark);
	}

	.page-header p {
		margin: 0;
		color: var(--color-text-muted);
	}

	.search-fallback {
		text-align: center;
		color: var(--color-text-muted);
	}
</style>

<style is:global>
	#search {
		--pagefind-ui-primary: var(--color-accent-dark);
		--pagefind-ui-text: var(--color-text);
		--pagefind-ui-background: var(--color-surface);
		--pagefind-ui-border: var(--color-border);
		--pagefind-ui-font: var(--font-body);
	}
</style>
