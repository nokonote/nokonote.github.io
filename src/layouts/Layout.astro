---
interface Props {
	title?: string;
	description?: string;
}

const { title = '旅ブログ', description = '国内旅行の記録をお届けするブログです。' } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&family=Noto+Sans+JP:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">本文へスキップ</a>
		<header class="site-header">
			<div class="site-header-inner">
				<a class="brand" href="/">
					<span class="brand-icon">🧳</span>
					<span class="brand-text">旅ブログ</span>
				</a>
				<nav class="site-nav">
					<a href="/">ホーム</a>
					<a href="/blog/">記事一覧</a>
				</nav>
			</div>
		</header>
		<slot />
		<footer class="site-footer">
			<p>🧳 旅ブログ ― 国内旅行の記録をゆるくお届けします。</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #fffbf5;
		--color-bg-alt: #fff3e9;
		--color-surface: #ffffff;
		--color-text: #33302e;
		--color-text-muted: #7a736c;
		--color-border: #f0e4d8;
		--color-accent: #ff7a5c;
		--color-accent-dark: #e85d3f;
		--color-sky: #2aa9bd;
		--color-sun: #f2a93b;
		--font-heading: 'Zen Maru Gothic', sans-serif;
		--font-body: 'Noto Sans JP', system-ui, sans-serif;
		--radius-sm: 10px;
		--radius-md: 16px;
		--radius-lg: 24px;
		--shadow-sm: 0 2px 8px rgba(51, 48, 46, 0.06);
		--shadow-md: 0 10px 30px rgba(51, 48, 46, 0.1);
		--shadow-lg: 0 20px 45px rgba(51, 48, 46, 0.14);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		min-height: 100%;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		line-height: 1.8;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: var(--font-heading);
		line-height: 1.4;
	}

	a {
		color: inherit;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		background: var(--color-accent);
		color: #fff;
		padding: 0.6rem 1rem;
		border-radius: 0 0 var(--radius-sm) 0;
		z-index: 100;
	}

	.skip-link:focus {
		left: 0;
	}
</style>

<style>
	.site-header {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.site-header-inner {
		max-width: 960px;
		margin: 0 auto;
		padding: 1rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.25rem;
		color: var(--color-accent-dark);
	}

	.brand-icon {
		font-size: 1.5rem;
	}

	.site-nav {
		display: flex;
		gap: 1.5rem;
		font-weight: 500;
	}

	.site-nav a {
		text-decoration: none;
		color: var(--color-text-muted);
		transition: color 0.15s ease;
	}

	.site-nav a:hover {
		color: var(--color-accent-dark);
	}

	.site-footer {
		text-align: center;
		padding: 3rem 1.25rem 2.5rem;
		color: var(--color-text-muted);
		font-size: 0.875rem;
	}
</style>
